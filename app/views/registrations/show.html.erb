<% content_for :registration_status, "shown" %>
<main>
  <h1><%= t("identity.registration.pending_title") %></h1>
  <% if notice.present? %>
    <p role="status"><%= notice %></p>
  <% end %>
  <%= render "registrations/pending_details", registration: @registration %>
  <%= button_to t("identity.registration.resend"), registration_email_path %>
  <%= link_to t("identity.registration.restart"), new_registration_path %>
  <%= link_to t("identity.registration.continue"), root_path %>
</main>

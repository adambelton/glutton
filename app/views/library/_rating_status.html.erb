<% if (status = library_film.rating_status) %>
  <p><%= t("library.browser.#{status}") %></p>
<% end %>
<% if library_film.can_rate? %>
  <%= link_to t("library.browser.rate"), new_rating_path(film_id: library_film.film_id),
    aria: { label: t("library.browser.rate_film", title: library_film.film.title) } %>
<% end %>
<% if library_film.can_edit_rating? %>
  <%= link_to t("library.browser.edit_rating"), edit_rating_path(film_id: library_film.film_id),
    aria: { label: t("library.browser.edit_film_rating", title: library_film.film.title) } %>
<% end %>

<main>
  <h1><%= t("app.name") %></h1>
  <p><%= t(".tagline") %></p>
  <p><%= link_to t("ratings.browser.title"), new_rating_path %></p>
  <% if notice.present? %>
    <p role="status"><%= notice %></p>
  <% end %>
  <% if current_user.present? %>
    <%= render current_user %>
  <% else %>
    <%= link_to t("identity.sessions.sign_in"), new_session_path %>
    <%= link_to t("identity.registration.title"), new_registration_path %>
  <% end %>
</main>

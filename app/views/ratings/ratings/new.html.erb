<% content_for :title, t("ratings.browser.title") %>
<main>
  <h1><%= t("ratings.browser.title") %></h1>
  <% if notice.present? %>
    <p role="status"><%= notice %></p>
  <% end %>
  <% if @rating_film %>
    <%= render "ratings/form", rating_film: @rating_film %>
    <% unless params.key?(:film_id) %>
      <%= button_to t("ratings.browser.dismiss"), dismiss_ratings_path, method: :post, params: { rating_film_id: @rating_film.id } %>
    <% else %>
      <p><%= link_to t("ratings.browser.continue"), new_rating_path %></p>
    <% end %>
  <% else %>
    <p><%= t("ratings.browser.empty") %></p>
  <% end %>
  <p><%= link_to t("ratings.browser.home"), root_path %></p>
</main>

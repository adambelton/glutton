<h2><%= rating_film.film.title %></h2>
<% if rating_film.film.release_date %>
  <p><%= t("ratings.browser.release_year", year: rating_film.film.release_date.year) %></p>
<% end %>
<% if @errors.present? %>
  <div id="rating-errors" role="alert" tabindex="-1">
    <h3><%= t("ratings.browser.correct_errors") %></h3>
    <ul><% @errors.each do |error| %><li><%= error %></li><% end %></ul>
  </div>
<% end %>
<%= form_with url: ratings_path, method: :post do %>
  <%= hidden_field_tag :rating_film_id, rating_film.id %>
  <fieldset aria-describedby="<%= 'rating-errors' if @errors.present? %>">
    <legend><%= t("ratings.browser.choice") %></legend>
    <% Rating::Values::ALL.each do |value| %>
      <div>
        <%= radio_button_tag :value, value, @value == value, id: "rating-#{value}", required: true %>
        <%= label_tag "rating-#{value}", t("ratings.values.#{value}") %>
      </div>
    <% end %>
  </fieldset>
  <details <%= "open" if @expression_texts.any?(&:present?) %>>
    <summary><%= t("ratings.browser.expressions") %></summary>
  <fieldset aria-describedby="expression-help<%= ' rating-errors' if @errors.present? %>">
    <legend><%= t("ratings.browser.expressions") %></legend>
    <p id="expression-help"><%= t("ratings.browser.expression_help", count: Rating::MAX_EXPRESSIONS, length: RatingExpression::MAX_TEXT_LENGTH) %></p>
    <% Rating::MAX_EXPRESSIONS.times do |index| %>
      <div>
        <%= label_tag "expression-#{index}", t("ratings.browser.expression", number: index + 1) %>
        <%= text_area_tag "expression_texts[]", @expression_texts[index], id: "expression-#{index}", maxlength: RatingExpression::MAX_TEXT_LENGTH, rows: 2 %>
      </div>
    <% end %>
  </fieldset>
  </details>
  <%= submit_tag t("ratings.browser.save") %>
<% end %>

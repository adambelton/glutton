<main>
  <h1>Sign in</h1>
  <% if @error %>
    <p role="alert"><%= @error %></p>
  <% end %>
  <%= form_with url: session_path do |form| %>
    <div>
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", autofocus: true %>
    </div>
    <div>
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </div>
    <%= form.submit "Sign in" %>
  <% end %>
</main>

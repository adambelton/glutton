<main>
  <h1><%= t("identity.sessions.sign_in") %></h1>
  <% if notice.present? %>
    <p role="status"><%= notice %></p>
  <% end %>
  <% if @error %>
    <p role="alert"><%= @error %></p>
  <% end %>
  <%= form_with url: session_path do |form| %>
    <div>
      <%= form.label :email_address, t("identity.sessions.email") %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", autofocus: true %>
    </div>
    <div>
      <%= form.label :password, t("identity.sessions.password") %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </div>
    <%= form.submit t("identity.sessions.sign_in") %>
  <% end %>
  <%= link_to t("identity.registration.title"), new_registration_path %>
  <%= link_to t("identity.recovery.forgot"), new_password_reset_path %>
</main>

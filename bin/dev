#!/usr/bin/env ruby

def stop_process_groups(process_groups)
  until process_groups.empty?
    pid = process_groups.shift
    begin
      Process.kill("TERM", -pid)
    rescue Errno::ESRCH
      # The process group has already exited.
    end
  end
end

abort "bin/dev only supports the development environment" if ENV.fetch("RAILS_ENV", "development") != "development"
system("./bin/rails", "tailwindcss:build", exception: true)

# Use the web database for development background jobs.
job_worker = [ { "JOB_DATABASE_URL" => nil }, "./bin/jobs", "--queues=domain_events,ratings_assessment,registry_assignment" ]
web_server = [ "./bin/rails", "server", *ARGV ]

pids = []
process_groups = []
%w[INT TERM].each { |signal| Signal.trap(signal) { stop_process_groups(process_groups) } }

begin
  [ job_worker, web_server ].each do |command|
    pid = Process.spawn(*command, pgroup: true)
    pids << pid
    process_groups << pid
  end

  finished_pid, status = Process.wait2
  exit_code = status.exitstatus || 128 + status.termsig
ensure
  stop_process_groups(process_groups)
  (pids - [ finished_pid ]).each { |pid| Process.wait(pid) }
end
exit exit_code
